#!/bin/bash
# Book4 Edge USB-C charging daemon: what Windows' EmuEc.sys does and Linux lacks.
#
#  1. Cable attached at the PDIC but no AC at the EC: re-issue "Consumer_switch_on"
#     to the S2MM006 (reg 0x4E = 0x12). The register is an action, not a state: it
#     reads 0x12 while wedged, and re-writing it closes the connector->charger path.
#     Readback reg 0x1C: b0 Provider, b1 Consumer, b2 Discharging (0x0A = closed).
#     Attach reg 0x0E: bit0 = cable attached; 0x03 once a contract exists, 0x05 seen on
#     a fresh attach before one. Any value with bit0 set counts as attached.
#
#  2. Upgrade the PD contract. On attach the PDIC requests PDO1 (5 V), a trickle for
#     a 17 V pack. The chip stages a Request at reg 0x0080; bit 6 of reg 0x50 sends it.
#     The staged buffer is not always a valid Request and a bad send glitches VBUS
#     (it has hard-reset the machine at low battery), so a transmit requires:
#       - the staged header decodes as a Request (type 2) with exactly one object,
#       - its object position is higher than the contract in force,
#       - at most MAX_TX_PER_ATTACH attempts per attach, TX_COOLDOWN_S apart.
#     Requests are rebuilt from Source_Capabilities and read back before transmission.
#     Provider ports are excluded from switch commands and PD negotiation.
#
#  3. Program the ISL9241 charger (0x09) from the smart battery's own request
#     (0x0B, regs 0x15/0x14): the standard SBS host algorithm. Without it the
#     charger sits at a ~320 mA trickle.
#  4. Set both adapter limits from the supplying port's last Request and its PDO.
#     Contract acceptance and board current-sense scaling need hardware validation.
#
# MAX_CURRENT_MA stays at or below what the factory firmware was observed using.
# A zero current request from the battery means "terminate" and is passed through.
# Request a stop above TEMP_LIMIT_DK or on invalid temperature/voltage reads.
# Stopping the daemon does not undo register writes or guarantee charging stops.
# Disable with: systemctl disable --now book4-pd-charge

set -u

MAX_CURRENT_MA=1500      # factory firmware observed at ~1432 mA. Do not exceed.
ADAPTER_LIMIT_MAX_MA=3000
TEMP_LIMIT_DK=3181       # 0.1 K units -> 45.0 C
VMIN_MV=10000
VMAX_MV=18000
POLL=2
MAX_TX_PER_ATTACH=2      # hard cap on PD transmissions per cable attach
TX_COOLDOWN_S=30         # never two transmissions closer than this, any port

log(){ echo "book4-pd-charge: $*"; }

# Find the controllers by SoC address, never by bus number (numbering follows
# probe order). PDIC port 0 sits on i2c@a84000, port 1 on i2c@a9c000, the
# ISL9241 charger and the SBS battery on i2c@890000. All three must be
# status = "okay" in the device tree (they are in the port's DTS).
bus_of(){
  local d
  for d in /sys/bus/i2c/devices/i2c-*; do
    case "$(readlink -f "$d")" in */$1.i2c/i2c-*) echo "${d##*/i2c-}"; return 0;; esac
  done
  return 1
}
[[ $# -eq 0 || ( $# -eq 1 && "$1" = --check ) ]] || { echo "Usage: $0 [--check]" >&2; exit 2; }
# Old DTB without the buses: try the overlay module from i2c-wake/ first.
if [ "${1:-}" != --check ]; then
  bus_of a84000 >/dev/null || { modprobe i2c-wake 2>/dev/null && sleep 1; } || true
fi
PD0=$(bus_of a84000) || { log "i2c@a84000 (PDIC port 0) not present; enable it in the device tree"; exit 1; }
PD1=$(bus_of a9c000) || { log "i2c@a9c000 (PDIC port 1) not present; enable it in the device tree"; exit 1; }
CHG=$(bus_of 890000) || { log "i2c@890000 (charger/battery) not present; enable it in the device tree"; exit 1; }

pd_read(){
  local data byte count=$4
  data=$(i2ctransfer -y "$1" w2@0x33 "$2" "$3" "r$count" 2>/dev/null) || return 1
  set -- $data
  [ $# -eq "$count" ] || return 1
  for byte; do
    [[ "$byte" =~ ^0x[[:xdigit:]]{2}$ ]] || return 1
  done
  echo "$data"
}
rd(){ pd_read "$1" 0x00 "$2" 1; }
rd8(){ pd_read "$1" "$2" "$3" 8; }
ac(){ head -1 /sys/class/power_supply/book4-ec-ac/online 2>/dev/null; }
hex(){ printf "%d" "$1" 2>/dev/null || echo 0; }
now_s(){ date +%s; }

# Decode "0xAA 0xBB ..." (8 bytes) into: header, type, nobj, rdo object position.
# Sets: H_TYPE H_NOBJ RDO_POS (all decimal), or returns 1 on a short/empty read.
decode_msg(){
  local s="$1" byte; set -- $s
  [ $# -eq 8 ] || return 1
  for byte; do
    [[ "$byte" =~ ^0x[[:xdigit:]]{2}$ ]] || return 1
  done
  local lo=$(hex "$1") hi=$(hex "$2") b7=$(hex "$8")
  local hdr=$(( (hi << 8) | lo ))
  [ $((hdr & 0x8100)) -eq 0 ] && [ "$b7" -lt 128 ] || return 1
  H_TYPE=$(( hdr & 0x1F ))
  H_NOBJ=$(( (hdr >> 12) & 0x7 ))
  RDO_POS=$(( b7 >> 4 ))
  return 0
}

source_caps(){
  local data hdr first
  data=$(pd_read "$1" 0x09 0x00 24) || return 1
  set -- $data
  hdr=$(( $1 | ($2 << 8) ))
  [ $((hdr & 0x811f)) -eq 257 ] && [ $(( (hdr >> 12) & 7 )) -ge 1 ] || return 1
  first=$(( $5 | ($6 << 8) | ($7 << 16) | ($8 << 24) ))
  [ $((first >> 30)) -eq 0 ] && [ $(( (first >> 10) & 0x3ff )) -eq 100 ] &&
    [ $((first & 0x3ff)) -gt 0 ] || return 1
  echo "$data"
}

# Re-arm one open input only when neither port reports an existing input path.
rearm_pd_bus(){
  local bus state switch selected=""
  for bus in "$PD0" "$PD1"; do
    state=$(rd "$bus" 0x0e) || return 1
    [ $((state & 1)) -eq 1 ] || continue
    switch=$(rd "$bus" 0x1c) || return 1
    [ $((switch & 2)) -eq 0 ] || return 1
    [ $((switch & 7)) -eq 0 ] || continue
    source_caps "$bus" >/dev/null || continue
    [ -n "$selected" ] || selected=$bus
  done
  [ -n "$selected" ] || return 1
  echo "$selected"
}

# Write a Request for the best fixed PDO above position $2 into the TX buffer (0x0080),
# built from the Source_Capabilities the chip received (0x0900: 2-byte header, 2 pad,
# then 4-byte PDOs). Returns 1 when nothing better than the current PDO is offered.
stage_request(){
  local bus=$1 cur=$2 caps hdr n i w v a best=0 bi=0 ba=0 rdo k expected
  [ "$(active_pd_bus)" = "$bus" ] || return 1
  caps=$(source_caps "$bus") || return 1
  set -- $caps; [ $# -eq 24 ] || return 1
  hdr=$(( ($(hex "$2") << 8) | $(hex "$1") )); n=$(( (hdr >> 12) & 7 ))
  [ "$cur" -ge 1 ] && [ "$cur" -le "$n" ] && [ "$cur" -le 5 ] || return 1
  shift 4
  for (( i=1; i<=n && i<=5; i++ )); do
    w=$(( $(hex "$1") | ($(hex "$2") << 8) | ($(hex "$3") << 16) | ($(hex "$4") << 24) )); shift 4
    [ $(( (w >> 30) & 3 )) -eq 0 ] || continue                  # fixed supply only
    v=$(( ((w >> 10) & 0x3ff) * 50 )); a=$(( w & 0x3ff ))
    [ "$v" -ge 5000 ] && [ "$v" -le 20000 ] && [ "$a" -gt 0 ] || continue
    [ "$v" -gt "$best" ] && { best=$v; bi=$i; ba=$a; }
  done
  [ "$bi" -gt "$cur" ] || return 1
  [ "$ba" -le $((ADAPTER_LIMIT_MAX_MA / 10)) ] || ba=$((ADAPTER_LIMIT_MAX_MA / 10))
  # RDO: position, USB comm capable, no USB suspend, operating = max current.
  rdo=$(( (bi << 28) | (1 << 25) | (1 << 24) | (ba << 10) | ba ))
  set -- 0x02 0x10 0x00 0x00 $(printf '0x%02x ' $(( rdo & 0xff )) $(( (rdo >> 8) & 0xff )) $(( (rdo >> 16) & 0xff )) $(( (rdo >> 24) & 0xff )))
  expected="$*"
  for k in 0 1 2 3 4 5 6 7; do
    i2ctransfer -y "$bus" w3@0x33 0x00 "$(printf '0x%02x' $(( 0x80 + k )))" "$1" 2>/dev/null || return 1
    shift
  done
  [ "$(rd8 "$bus" 0x00 0x80)" = "$expected" ] || return 1
  [ "$(source_caps "$bus")" = "$caps" ] || return 1
  STAGED_REQUEST=$expected
  log "i2c-$bus: staged Request for PDO $bi (${best} mV, $(( ba * 10 )) mA)"
}

# Identify one attached port with its consumer switch closed.
active_pd_bus(){
  local bus state switch selected=""
  for bus in "$PD0" "$PD1"; do
    state=$(rd "$bus" 0x0e) || return 1
    [[ "$state" =~ ^0x[[:xdigit:]]{2}$ ]] || return 1
    [ $((state & 1)) -eq 1 ] || continue
    switch=$(rd "$bus" 0x1c) || return 1
    [[ "$switch" =~ ^0x[[:xdigit:]]{2}$ ]] || return 1
    [ "$((switch))" -eq 10 ] || continue
    [ -z "$selected" ] || return 1
    selected=$bus
  done
  [ -n "$selected" ] || return 1
  echo "$selected"
}

adapter_limit_target(){
  local bus request after caps byte hdr pos rdo pdo voltage offered operating maximum limit
  bus=$(active_pd_bus) || return 1
  request=$(rd8 "$bus" 0x06 0xa0) || return 1
  caps=$(source_caps "$bus") || return 1
  for byte in $request $caps; do
    [[ "$byte" =~ ^0x[[:xdigit:]]{2}$ ]] || return 1
  done
  set -- $request
  [ $# -eq 8 ] || return 1
  hdr=$(( $1 | ($2 << 8) ))
  [ $((hdr & 0xf11f)) -eq 4098 ] || return 1
  rdo=$(( $5 | ($6 << 8) | ($7 << 16) | ($8 << 24) ))
  [ $((rdo & 0x88000000)) -eq 0 ] || return 1
  pos=$(( (rdo >> 28) & 7 ))
  operating=$(( ((rdo >> 10) & 0x3ff) * 10 ))
  maximum=$(( (rdo & 0x3ff) * 10 ))
  set -- $caps
  [ $# -eq 24 ] || return 1
  hdr=$(( $1 | ($2 << 8) ))
  [ $((hdr & 0x801f)) -eq 1 ] || return 1
  [ "$pos" -ge 1 ] && [ "$pos" -le 5 ] &&
    [ "$pos" -le $(( (hdr >> 12) & 7 )) ] || return 1
  shift $((4 * pos))
  pdo=$(( $1 | ($2 << 8) | ($3 << 16) | ($4 << 24) ))
  [ $((pdo >> 30)) -eq 0 ] || return 1
  voltage=$(( ((pdo >> 10) & 0x3ff) * 50 ))
  offered=$(( (pdo & 0x3ff) * 10 ))
  [ "$voltage" -ge 5000 ] && [ "$voltage" -le 20000 ] || return 1
  [ "$operating" -gt 0 ] && [ "$operating" -le "$maximum" ] &&
    [ "$maximum" -le "$offered" ] || return 1
  [ "$(active_pd_bus)" = "$bus" ] || return 1
  after=$(rd8 "$bus" 0x06 0xa0) || return 1
  [ "$after" = "$request" ] || return 1
  limit=$operating
  [ "$limit" -le "$ADAPTER_LIMIT_MAX_MA" ] || limit=$ADAPTER_LIMIT_MAX_MA
  # ISL9241 current fields use bits 12:2 with the standard sense resistors.
  echo $((limit / 4 * 4))
}

set_adapter_limit(){
  local limit reg before after
  limit=$(adapter_limit_target) || return 1
  for reg in 0x3b 0x3f; do
    before=$(i2cget -y "$CHG" 0x09 "$reg" w 2>/dev/null) || return 1
    [[ "$before" =~ ^0x[[:xdigit:]]{4}$ ]] || return 1
    [ "$((before))" -ne 65535 ] || return 1
    [ "$((before))" -ne "$limit" ] || continue
    i2cset -y "$CHG" 0x09 "$reg" "$(printf '0x%04x' "$limit")" w 2>/dev/null || return 1
    after=$(i2cget -y "$CHG" 0x09 "$reg" w 2>/dev/null) || return 1
    [[ "$after" =~ ^0x[[:xdigit:]]{4}$ ]] && [ "$((after))" -eq "$limit" ] || return 1
    log "adapter limit $reg verified: $limit"
  done
}

# Failed/malformed SBS reads must not become permission to charge.
sbs_word(){
  local value
  value=$(i2cget -y "$CHG" 0x0b "$1" w 2>/dev/null) || return 1
  [[ "$value" =~ ^0x[[:xdigit:]]{4}$ ]] || return 1
  [ "$((value))" -ne 65535 ] || return 1
  printf '%d\n' "$value"
}

stop_charge(){
  if i2cset -y "$CHG" 0x09 0x14 0x0000 w 2>/dev/null; then
    [ "${last_stop_reason:-}" = "$1" ] || log "$1"
    last_stop_reason=$1
  else
    log "ERROR: could not request charging stop ($1)"
  fi
  last_c=-1; last_v=-1
}

check_input(){
  local bus limit reg value
  bus=$(active_pd_bus) || { log "No unique supplying port"; return 1; }
  limit=$(adapter_limit_target) || { log "Input-limit target unavailable"; return 1; }
  printf 'Input bus: %s\nLast-Request limit target: %s\n' "$bus" "$limit"
  for reg in 0x3f 0x3b 0x14 0x15; do
    value=$(i2cget -y "$CHG" 0x09 "$reg" w 2>/dev/null) || return 1
    [[ "$value" =~ ^0x[[:xdigit:]]{4}$ ]] || return 1
    printf 'Charger %s: %s (%d raw)\n' "$reg" "$value" "$value"
  done
}

if [ "${1:-}" = --check ]; then
  check_input
  exit $?
fi

declare -A tx_count      # bus -> transmissions this attach
last_tx=0
last_input=""
last_v=-1; last_c=-1

while true; do
  # --- 1. close the consumer VBUS switch if the cable is attached but AC is absent
  if [ "$(ac)" = "0" ] && bus=$(rearm_pd_bus); then
    for i in 1 2 3 4 5; do
      [ "$(rearm_pd_bus)" = "$bus" ] || break
      i2ctransfer -y "$bus" w3@0x33 0x00 0x4e 0x12 2>/dev/null || break
      sleep 0.02
      [ "$(rd "$bus" 0x1c)" = "0x0a" ] && break
    done
    log "i2c-$bus: consumer switch request (0x1C=$(rd "$bus" 0x1c), ac=$(ac))"
    last_v=-1; last_c=-1
    sleep 1
  fi

  # --- 2. upgrade the PD contract, guarded (see header comment)
  for bus in $PD0 $PD1; do
    state=$(rd "$bus" 0x0e) || continue
    if [ $((state & 1)) -eq 0 ]; then
      tx_count[$bus]=0
      continue
    fi
    [ "$(active_pd_bus)" = "$bus" ] || continue
    [ "$(ac)" = "1" ] || continue
    [ "${tx_count[$bus]:-0}" -ge "$MAX_TX_PER_ATTACH" ] && continue
    [ $(( $(now_s) - last_tx )) -ge "$TX_COOLDOWN_S" ] || continue

    sent=$(rd8 "$bus" 0x06 0xa0); decode_msg "$sent" || continue
    [ "$H_TYPE" -eq 2 ] && [ "$H_NOBJ" -eq 1 ] || continue
    c_pos=$RDO_POS
    ctrl=$(rd "$bus" 0x50) || continue
    [ $((ctrl & 0x40)) -eq 0 ] || continue
    stage_request "$bus" "$c_pos" || continue
    staged=$(rd8 "$bus" 0x00 0x80) || continue
    [ "$staged" = "$STAGED_REQUEST" ] && decode_msg "$staged" || continue
    s_type=$H_TYPE; s_nobj=$H_NOBJ; s_pos=$RDO_POS

    # only a genuine single-object Request, and only if it is an actual upgrade
    [ "$s_type" -eq 2 ] && [ "$s_nobj" -eq 1 ] || continue
    [ "$s_pos" -gt "$c_pos" ] && [ "$s_pos" -le 7 ] || continue

    [ "$(active_pd_bus)" = "$bus" ] || continue
    ctrl=$(rd "$bus" 0x50) || continue
    cv=$(hex "$ctrl"); [ $(( cv & 0x40 )) -ne 0 ] && continue    # transmitter busy
    [ "$(rd8 "$bus" 0x00 0x80)" = "$STAGED_REQUEST" ] || continue

    if i2ctransfer -y "$bus" w3@0x33 0x00 0x50 "$(printf '0x%02x' $(( cv | 0x40 )))" 2>/dev/null; then
      tx_result=sent
    else
      tx_result=failed
    fi
    tx_count[$bus]=$(( ${tx_count[$bus]:-0} + 1 ))
    last_tx=$(now_s)
    sleep 2
    decode_msg "$(rd8 "$bus" 0x06 0xa0)" && n_pos=$RDO_POS || n_pos=$c_pos
    log "i2c-$bus: PD Request $tx_result (pos $c_pos -> requested $s_pos, observed $n_pos, attempt ${tx_count[$bus]}/$MAX_TX_PER_ATTACH)"
    [ "$n_pos" -gt "$c_pos" ] || log "i2c-$bus: Request position unchanged"
  done

  # --- 3. keep the ISL9241 programmed from the battery's own request
  input=$(active_pd_bus) || input=""
  if [ "$input" != "$last_input" ]; then
    last_v=-1; last_c=-1
    last_input=$input
  fi
  if [ "$(ac)" = "1" ]; then
    set_adapter_limit || log "adapter limit update deferred: state uncertain or I2C failure"
    v=$(sbs_word 0x15) || v=0
    c=$(sbs_word 0x14) || c=-1
    if [ "$c" -le 0 ]; then
      c=$(sbs_word 0x14) || c=-1
    fi
    t=$(sbs_word 0x08) || t=0
    if [ "$t" -eq 0 ]; then
      t=$(sbs_word 0x08) || t=0
    fi
    if [ "$v" -lt "$VMIN_MV" ] || [ "$v" -gt "$VMAX_MV" ]; then
      v=$(sbs_word 0x15) || v=0
    fi

    if [ "$t" -eq 0 ] || [ "$t" -gt "$TEMP_LIMIT_DK" ] || [ "$c" -lt 0 ]; then
      stop_charge "battery read unavailable or temperature over limit (t=$t, c=$c)"
    elif [ "$c" -eq 0 ]; then
      # A completed charge can report both requested current and voltage as zero.
      stop_charge "battery requests zero charge current"
    elif [ "$v" -lt "$VMIN_MV" ] || [ "$v" -gt "$VMAX_MV" ]; then
      stop_charge "battery voltage request invalid (v=$v)"
    else
      last_stop_reason=""
      [ "$c" -gt "$MAX_CURRENT_MA" ] && c=$MAX_CURRENT_MA
      if [ "$v" != "$last_v" ] || [ "$c" != "$last_c" ]; then
        if i2cset -y "$CHG" 0x09 0x15 "$(printf '0x%04x' "$v")" w 2>/dev/null &&
           i2cset -y "$CHG" 0x09 0x14 "$(printf '0x%04x' "$c")" w 2>/dev/null; then
          log "charger write accepted: ${v} mV / ${c} mA (not verified)"
          last_v=$v; last_c=$c
        else
          log "ERROR: charger write failed. Requesting stop and retrying next poll"
          i2cset -y "$CHG" 0x09 0x14 0x0000 w 2>/dev/null || log "ERROR: stop write failed"
          last_v=-1; last_c=-1
        fi
      fi
    fi
  else
    last_v=-1; last_c=-1
    last_stop_reason=""
  fi

  sleep "$POLL"
done
